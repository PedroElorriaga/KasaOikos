# Copie para `.env` (ignorado pelo git) e troque todos os valores.
# Os valores abaixo são FALSOS. Nunca coloque um segredo real neste arquivo:
# o repositório é público.
# As chaves ainda são um esboço: cada mudança da fase 0 ajusta as suas.

# --- Postgres (M0.3) ---
POSTGRES_PASSWORD=troque-me
APP_DB_USER=kasaoikos_app
APP_DB_PASSWORD=troque-me
KEYCLOAK_DB_USER=kasaoikos_keycloak
KEYCLOAK_DB_PASSWORD=troque-me

# --- Keycloak (M0.3) ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=troque-me
# Senhas dos usuários de teste do realm (ana.teste e bruno.teste).
# Política do realm: mínimo de 12 caracteres, diferente do usuário e do e-mail.
KC_SENHA_USUARIO_TESTE_1=troque-me-ana-1
KC_SENHA_USUARIO_TESTE_2=troque-me-bruno-2

# --- API (M0.2 e M0.5) ---
DATABASE_URL=postgresql+psycopg://kasaoikos_app:troque-me@localhost:5432/app
OIDC_ISSUER=http://localhost:8080/realms/kasaoikos
OIDC_AUDIENCE=kasaoikos-api
