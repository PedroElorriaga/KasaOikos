# Copie para loadtest/.env na estação e preencha com os valores do infra/.env do servidor.
# O .env não é versionado. Para rodar contra o Compose da própria estação, use
# --env-file infra/.env em vez deste arquivo.

# Endereço do servidor (o mesmo de $env:HM_SERVER)
HM_SERVER=192.168.0.10
API_PORT=8000
KEYCLOAK_PORT=8080
POSTGRES_PORT=5432
PROMETHEUS_PORT=9090

# Seed: Admin API do Keycloak e escrita no Postgres como hm_migrator
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
HM_MIGRATOR_PASSWORD=change-me
HM_SEED_USER_PASSWORD=change-me
SEED_HOUSEHOLDS=1000

# k6: login dos usuários do seed pelo client home-loadtest
HM_LOADTEST_CLIENT_SECRET=change-me

# Configuração da API no servidor, só para registro no resultado: mantenha igual à do
# infra/.env de lá (o k6 não tem como descobri-la).
HM_WORKERS=2
HM_DB_POOL_SIZE=10
