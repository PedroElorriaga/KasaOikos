{
  "uid": "api-overview",
  "title": "API Overview",
  "description": "Home Manager API: RED por rota, pool do banco e cache de membership (tarefa 6.5).",
  "tags": [
    "home-manager",
    "api"
  ],
  "editable": false,
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "type": "row",
      "title": "RED por rota (Rate, Errors, Duration)",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 2,
      "title": "Requisições por segundo, por rota",
      "description": "Taxa de requisições da API por rota template (sem ids concretos: spec platform/observability).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "stacking": {
              "mode": "none"
            },
            "fillOpacity": 5
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (http_route, http_request_method) (rate(http_server_request_duration_seconds_count{job=\"home-api\"}[$__rate_interval]))",
          "legendFormat": "{{http_request_method}} {{http_route}}",
          "exemplar": false,
          "range": true
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 3,
      "title": "Respostas de erro por status",
      "description": "4xx são esperados (401, 403, 404 de isolamento); 5xx são falhas da API.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 15
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (http_response_status_code) (rate(http_server_request_duration_seconds_count{job=\"home-api\", http_response_status_code=~\"4..|5..\"}[$__rate_interval]))",
          "legendFormat": "{{http_response_status_code}}",
          "exemplar": false,
          "range": true
        }
      ]
    },
    {
      "type": "stat",
      "id": 4,
      "title": "Erros 5xx (%)",
      "description": "Fração de respostas 5xx. O threshold inicial do k6 é http_req_failed < 1%.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * (sum(rate(http_server_request_duration_seconds_count{job=\"home-api\", http_response_status_code=~\"5..\"}[$__rate_interval])) or vector(0)) / clamp_min(sum(rate(http_server_request_duration_seconds_count{job=\"home-api\"}[$__rate_interval])), 1e-9)",
          "legendFormat": "5xx",
          "exemplar": false,
          "range": true
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 5,
      "title": "Latência p50 / p95 / p99 (todas as rotas)",
      "description": "Os pontos (exemplars) levam ao trace da requisição no Tempo. Threshold inicial: p95 < 200 ms em leitura.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "stacking": {
              "mode": "none"
            },
            "fillOpacity": 5
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(http_server_request_duration_seconds_bucket{job=\"home-api\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "exemplar": true,
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{job=\"home-api\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "exemplar": true,
          "range": true
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_request_duration_seconds_bucket{job=\"home-api\"}[$__rate_interval])))",
          "legendFormat": "p99",
          "exemplar": true,
          "range": true
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 6,
      "title": "Latência p95 por rota",
      "description": "Qual rota puxa o p95 para cima.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "stacking": {
              "mode": "none"
            },
            "fillOpacity": 5
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, http_route) (rate(http_server_request_duration_seconds_bucket{job=\"home-api\"}[$__rate_interval])))",
          "legendFormat": "{{http_route}}",
          "exemplar": true,
          "range": true
        }
      ]
    },
    {
      "type": "row",
      "title": "Banco e cache",
      "id": 7,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 8,
      "title": "Pool de conexões do banco",
      "description": "Conexões em uso e ociosas, somando todos os workers. Total máximo = workers × (pool_size + max_overflow): experimento 8.6.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 15
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (state) (db_client_connections_usage{job=\"home-api\"})",
          "legendFormat": "{{state}}",
          "exemplar": false,
          "range": true
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 9,
      "title": "Hit ratio do cache de membership",
      "description": "Hits / (hits + misses). Requisições a lares de que o usuário não é membro (404) são sempre miss: \"não é membro\" não vai para o cache (design D6).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 19,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "stacking": {
              "mode": "none"
            },
            "fillOpacity": 5
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(hm_membership_cache_lookups_total{job=\"home-api\", result=\"hit\"}[$__rate_interval])) / clamp_min(sum(rate(hm_membership_cache_lookups_total{job=\"home-api\", result=~\"hit|miss\"}[$__rate_interval])), 1e-9)",
          "legendFormat": "hit ratio",
          "exemplar": false,
          "range": true
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 10,
      "title": "Consultas ao cache por resultado",
      "description": "\"error\" = Redis indisponível; a consulta cai para o banco.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 19,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 15
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (result) (rate(hm_membership_cache_lookups_total{job=\"home-api\"}[$__rate_interval]))",
          "legendFormat": "{{result}}",
          "exemplar": false,
          "range": true
        }
      ]
    },
    {
      "type": "row",
      "title": "Carga do k6 (lado do cliente)",
      "id": 11,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 27
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 12,
      "title": "k6: requisições/s por execução",
      "description": "Taxa enviada pelo k6, por execução (testid = data-sha-cenário, o mesmo nome do JSON em loadtest/results/).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "stacking": {
              "mode": "none"
            },
            "fillOpacity": 5
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (testid) (rate(k6_http_reqs_total{group!=\"::setup\"}[$__rate_interval]))",
          "legendFormat": "{{testid}}",
          "exemplar": false,
          "range": true
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 13,
      "title": "Latência p95: cliente (k6) × servidor (API)",
      "description": "A diferença é o que fica fora da API: rede, fila antes do uvicorn aceitar a conexão e o próprio k6. Distância crescendo sob carga = fila.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 28,
        "w": 10,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "stacking": {
              "mode": "none"
            },
            "fillOpacity": 5
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum(rate(k6_http_req_duration_seconds{group!=\"::setup\"}[$__rate_interval])))",
          "legendFormat": "k6 (cliente)",
          "exemplar": false,
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{job=\"home-api\"}[$__rate_interval])))",
          "legendFormat": "API (servidor)",
          "exemplar": false,
          "range": true
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 14,
      "title": "k6: VUs ativos",
      "description": "No modelo aberto (arrival rate), VUs subindo sem a taxa subir = respostas mais lentas segurando VUs.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 28,
        "w": 6,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "stacking": {
              "mode": "none"
            },
            "fillOpacity": 5
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(k6_vus)",
          "legendFormat": "VUs",
          "exemplar": false,
          "range": true
        }
      ]
    }
  ]
}
