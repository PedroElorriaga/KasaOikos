# Copie para infra/.env e troque as senhas. O .env não é versionado.

# Postgres (superusuário do container; a API e as migrações usam roles próprios)
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
POSTGRES_MAX_CONNECTIONS=100
# Roles do banco "home": migrações/seed e API (criados no primeiro boot do volume)
HM_MIGRATOR_PASSWORD=change-me
HM_APP_PASSWORD=change-me

# Valkey (cache de membership)
VALKEY_PASSWORD=change-me
VALKEY_PORT=6379

# Keycloak
KEYCLOAK_DB_PASSWORD=change-me
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
KEYCLOAK_PORT=8080
# Endereço pelo qual a estação e o k6 acessam o Keycloak; vira o "iss" dos tokens.
# No servidor, use o IP dele na rede, sem < > (ex.: http://192.168.15.9:8080).
KEYCLOAK_PUBLIC_URL=http://localhost:8080
# Segredo do client home-loadtest (dev-only), usado pelo k6 e pelo seed.
HM_LOADTEST_CLIENT_SECRET=change-me
# Senha comum dos usuários sintéticos do seed (loadtest/seed.py); o k6 faz login com ela.
HM_SEED_USER_PASSWORD=change-me

# API (container): porta, processos e pool por processo (experimento D9)
API_PORT=8000
HM_WORKERS=2
HM_DB_POOL_SIZE=10
HM_LOG_LEVEL=INFO

# Observabilidade
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
